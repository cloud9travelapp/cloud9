# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# skill install artifacts (local tooling, not app code)
# NOTE: .claude/skills/ IS committed (project capabilities; sessions run in
# fresh worktrees, so uncommitted skills would not survive to the next session)
.agents/
skills-lock.json

# database dumps — NEVER commit these: cloud9-data.sql contains every user's
# real chat messages, trips and preferences. Keep backups OUTSIDE the repo
# (e.g. C:\Users\maxai\cloud9-backups\). This is a safety net, not the plan.
# NOTE: deliberately narrow so supabase/migrations/*.sql stays tracked.
/cloud9-*.sql
/*.dump
/*.backup

# local tooling output (rebuild on demand; never shared)
# graphify-out/: ~700KB graph.json rewritten wholesale on every build — pure
# churn in a single-committer repo. Rebuild with `graphify extract . --code-only`.
graphify-out/
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts
